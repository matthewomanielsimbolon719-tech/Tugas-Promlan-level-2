<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kelas.controller.FormController">
   <children>
      <Label layoutX="40.0" layoutY="30.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Form Tambah Produk" />
      
      <Label layoutX="40.0" layoutY="80.0" text="Kode Produk:" />
      <TextField fx:id="txtKode" layoutX="140.0" layoutY="75.0" prefWidth="200.0" />
      
      <Label layoutX="40.0" layoutY="125.0" text="Nama Produk:" />
      <TextField fx:id="txtNama" layoutX="140.0" layoutY="120.0" prefWidth="200.0" />
      
      <Label layoutX="40.0" layoutY="170.0" text="Kategori:" />
      <ComboBox fx:id="cbKategori" layoutX="140.0" layoutY="165.0" prefWidth="200.0" />
      
      <Label layoutX="40.0" layoutY="215.0" text="Harga:" />
      <TextField fx:id="txtHarga" layoutX="140.0" layoutY="210.0" prefWidth="200.0" />
      
      <Button layoutX="140.0" layoutY="270.0" mnemonicParsing="false" onAction="#simpanProduk" text="Simpan &amp; Lihat Daftar" />
   </children>
</AnchorPane>